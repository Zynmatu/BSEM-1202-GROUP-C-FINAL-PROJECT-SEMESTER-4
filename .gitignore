# ══════════════════════════════════════════════════════════════════
#  HR Management API — .gitignore
#  FastAPI · PostgreSQL · SQLAlchemy · Python 3.11+
# ══════════════════════════════════════════════════════════════════


# ── Secrets & environment ──────────────────────────────────────────
# NEVER commit real credentials or secret keys
.env
.env.local
.env.production
.env.staging
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets.json


# ── Python ────────────────────────────────────────────────────────
# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Type stubs
*.pyi


# ── Virtual environments ───────────────────────────────────────────
# All common venv folder names
venv/
.venv/
env/
.env/
ENV/
venv.bak/
.venv.bak/


# ── Testing ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
nosetests.xml
test-results/
*.test.db
.tox/
.nox/


# ── Alembic ───────────────────────────────────────────────────────
# Keep the migrations folder and alembic.ini but not generated cache
alembic/__pycache__/
# Uncomment below if you want to exclude migration files too (not recommended)
# alembic/versions/


# ── Database ───────────────────────────────────────────────────────
# SQLite test databases (we use PostgreSQL but just in case)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# PostgreSQL dumps
*.sql.gz
*.dump
*.pgdump


# ── Logs ──────────────────────────────────────────────────────────
*.log
*.log.*
logs/
log/
uvicorn.log
gunicorn.log
access.log
error.log


# ── IDEs & editors ────────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Spyder
.spyderproject.cfg
.spyproject


# ── OS generated files ─────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ── Static / uploaded files ────────────────────────────────────────
# Ignore uploaded user files but keep the static folder structure
static/uploads/
media/
uploads/

# Keep the favicon and any committed static assets
!static/favicon.svg
!static/css/
!static/js/


# ── Caching & temp ─────────────────────────────────────────────────
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pylint.d/
.hypothesis/
tmp/
temp/
.tmp/


# ── Docker ────────────────────────────────────────────────────────
# Keep Dockerfile and docker-compose.yml but ignore local overrides
docker-compose.override.yml
docker-compose.local.yml
.dockerignore


# ── Node (if any frontend tooling is added) ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ── Deployment ────────────────────────────────────────────────────
*.tar.gz
*.zip
*.bak
*.backup
.terraform/
*.tfstate
*.tfstate.backup


# ── Jupyter (if used for data analysis) ───────────────────────────
.ipynb_checkpoints/
*.ipynb


# ══════════════════════════════════════════════════════════════════
#  Files that are SAFE to commit (do not add these to .gitignore):
#
#  ✅ .env.example        — template with no real values
#  ✅ requirements.txt    — package list
#  ✅ alembic.ini         — migration config (no secrets)
#  ✅ alembic/versions/   — migration scripts
#  ✅ main.py             — app entry point
#  ✅ app/                — all source code
#  ✅ templates/          — HTML templates
#  ✅ static/favicon.svg  — public assets
#  ✅ README.md           — documentation
#  ✅ .vscode/launch.json — VS Code debug config
# ══════════════════════════════════════════════════════════════════